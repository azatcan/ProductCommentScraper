@model ProductCommentScraper.Domain.Application.Dtos.ProductDto
@{
    ViewData["Title"] = "Detail";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@{
    ViewData["Title"] = "Ürün Detayı";
}

<div class="container mt-5">
    <h1 class="display-6 fw-semibold mb-4">@ViewData["Title"]</h1>

    <div class="row">
        <div class="col-md-5">
            <img src="@Model.ImageUrl" alt="@Model.ModelName" class="img-fluid rounded shadow-sm" />
        </div>
        <div class="col-md-7">
            <h2 class="fw-bold">@Model.Brand - @Model.ModelName</h2>
            <p class="text-muted">@Model.Description</p>
            <p class="fs-5 mt-3">
                <strong>Fiyat:</strong> <span class="text-success">@Model.Price.ToString("C")</span>
            </p>
        </div>
    </div>

    <hr class="my-5" />

    <h3 class="mb-3">Yorumlar</h3>
    <div class="row row-cols-1 row-cols-md-2 g-4">
        @foreach (var review in Model.Reviews)
        {
            <div class="col">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <h5 class="card-title">@review.Username</h5>
                        <h6 class="card-subtitle mb-2 text-muted">@review.Rating / 5 ⭐</h6>
                        <p class="card-text">@review.Comment</p>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="mt-5">
        <a href="@Url.Action("Index", "Product")" class="btn btn-outline-primary">
            <i class="bi bi-arrow-left"></i> Geri
        </a>
    </div>
</div>

