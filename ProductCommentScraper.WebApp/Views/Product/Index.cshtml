@model List<ProductCommentScraper.Domain.Application.Dtos.ProductDto>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@{
    ViewData["Title"] = "Ürün Listesi";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="display-5 fw-bold">@ViewData["Title"]</h1>
        <a href="@Url.Action("Scrape", "Product")" class="btn btn-primary">
            <i class="bi bi-cloud-download"></i> Yeni Ürünleri Çek
        </a>
    </div>

    <div class="table-responsive shadow-sm rounded">
        <table class="table table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th scope="col">Marka</th>
                    <th scope="col">Model</th>
                    <th scope="col">Fiyat</th>
                    <th scope="col">Detay</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var product in Model)
                {
                    <tr>
                        <td>@product.Brand</td>
                        <td>@product.ModelName</td>
                        <td>@product.Price.ToString("C")</td>
                        <td>
                            <a href="@Url.Action("Detail", "Product", new { id = product.Id })" class="btn btn-outline-secondary btn-sm">
                                Detay
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

